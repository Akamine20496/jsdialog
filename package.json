  "description": "Promised-based JavaScript Dialog Utility",
  "keywords": [
    "javascript-dialog",
    "jsdialog",
    "promised-based",
    "dialog"
  ],
  "homepage": "https://github.com/Akamine20496/jsdialog#readme",
  "bugs": {
    "url": "https://github.com/Akamine20496/jsdialog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akamine20496/jsdialog.git"
  },
  "license": "ISC",
  "author": "Akamine20496",
  "type": "module",
  "main": "dist/Dialog.min.js",
  "types": "dist/Dialog.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "shx mkdir -p dist && esbuild src/Dialog.js --minify --format=esm --outfile=dist/Dialog.min.js && shx cp src/Dialog.d.ts dist/",
    "watch": "npm run build && esbuild src/Dialog.js --minify --format=esm --outfile=dist/Dialog.min.js --watch",
    "clean": "shx rm -rf dist"
  },
  "devDependencies": {
    "csstype": "^3.2.3",
    "esbuild": "^0.28.2",
    "shx": "^0.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@75lb/deep-merge": "^1.1.5"
  }
}
